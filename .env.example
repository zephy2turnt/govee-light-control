# Copy this file to .env, then fill in your own values.
# Do not commit your real .env file.

# Optional for LAN-only control, but recommended so devices get friendly names.
GOVEE_EMAIL=your-govee-email@example.com
GOVEE_PASSWORD=your-govee-password

# Optional for basic LAN control, required for cloud-only devices, scenes,
# music modes, DIY effects, and some segment controls.
GOVEE_API_KEY=your-govee-api-key

# Your MQTT broker. If you run Mosquitto on the same machine, localhost is fine.
# If you use Home Assistant's Mosquitto add-on, use the Home Assistant host/IP.
GOVEE_MQTT_HOST=localhost
GOVEE_MQTT_PORT=1883
#GOVEE_MQTT_USER=your-mqtt-user
#GOVEE_MQTT_PASSWORD=your-mqtt-password

# Use F if you prefer Fahrenheit.
GOVEE_TEMPERATURE_SCALE=F

# Minnesota/Central time for log timestamps.
TZ=America/Chicago

# Helpful while first setting this up.
RUST_LOG_STYLE=always
#RUST_LOG=govee=info
